{
  "name": "@gera/design-system",
  "version": "0.1.0",
  "description": "Design system da GERA, plataforma do Comitê Social ACIJS: tokens, CSS, preset Tailwind, logos e componentes React.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./gera.css": "./src/styles/gera.css",
    "./tokens.css": "./src/tokens/tokens.css",
    "./tokens.json": "./src/tokens/tokens.json",
    "./tailwind-preset": "./src/tokens/tailwind-preset.ts",
    "./assets/*": "./src/assets/*"
  },
  "files": ["src", "README.md"],
  "sideEffects": ["*.css"],
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "react": "^18.3.1",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  }
}
