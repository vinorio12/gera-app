{
  "name": "gera-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-tokens.mjs && tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "check:tokens": "node scripts/check-tokens.mjs",
    "build:static": "node scripts/check-tokens.mjs && tsc -b && vite build --mode static --base ./ --outDir dist-static && node scripts/artifact-page.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "icones": "node scripts/gerar-icones.mjs"
  },
  "dependencies": {
    "@gera/design-system": "file:./packages/gera-ds",
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.104.3",
    "@zxing/browser": "^0.2.1",
    "date-fns": "^4.4.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.57.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
